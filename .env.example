# ---------------------------------------------------------------------------
# IPChek configuration. Copy to .env and edit. Every value has a sane default.
# ---------------------------------------------------------------------------

# HTTP server
PORT=8080
HOST=0.0.0.0

# Where the SQLite database and the downloaded source cache live
DATA_DIR=./data

# Default data source used when a request does not specify one.
# One of: rir | ipverse | ipdeny | dbip
SOURCE=rir

# Automatic refresh of monitored countries.
# Interval in minutes; set to 0 to disable the scheduler entirely.
SYNC_INTERVAL_MINUTES=360

# Run a sync for every monitored country right after the server boots.
SYNC_ON_START=true

# How long a downloaded source file stays usable before it is re-fetched (minutes).
SOURCE_CACHE_MINUTES=60

# How many change events to keep per monitor (older ones are pruned; 0 = keep all)
EVENT_RETENTION=500

# --- Optional: protect write operations (monitors, manual sync) with a token.
# When set, those endpoints require:  Authorization: Bearer <token>
# Read-only browsing and exports stay public so routers can fetch lists.
# API_TOKEN=

# --- Optional notifications, fired when a monitored country changes ----------

# Generic webhook: receives a JSON POST with the full change payload
# NOTIFY_WEBHOOK_URL=https://example.com/hooks/ipchek

# Telegram
# NOTIFY_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# NOTIFY_TELEGRAM_CHAT_ID=-1001234567890

# Slack / Mattermost incoming webhook
# NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Discord webhook
# NOTIFY_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Outbound HTTP proxy for fetching sources (optional)
# HTTPS_PROXY=http://127.0.0.1:8888
